                <mxCell id="g1" value="&lt;b style=&quot;font-size:15px&quot;&gt;apps/desktop&lt;/b&gt;&lt;div style=&quot;font-size:10px;font-weight:400;color:#9199a4&quot;&gt;Flutter&lt;/div&gt;&lt;div style=&quot;font-size:11px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;bootstrap/ · screens/&lt;br&gt;one folder per feature&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=top;align=center;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=2;fontColor=#204d7d;spacingTop=12;spacingLeft=14;spacingRight=14;" parent="1" vertex="1">
                    <mxGeometry x="48" y="110" width="200" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="g2" value="&lt;b style=&quot;font-size:15px&quot;&gt;tom_ui&lt;/b&gt;&lt;div style=&quot;font-size:10px;font-weight:400;color:#9199a4&quot;&gt;Flutter&lt;/div&gt;&lt;div style=&quot;font-size:11px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;theme/ · widgets/&lt;br&gt;depends on no package&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=top;align=center;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=2;fontColor=#204d7d;spacingTop=12;spacingLeft=14;spacingRight=14;" parent="1" vertex="1">
                    <mxGeometry x="314" y="110" width="200" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="g3" value="&lt;b style=&quot;font-size:15px&quot;&gt;tom_core&lt;/b&gt;&lt;div style=&quot;font-size:11px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;Result · AppFailure · Observability&lt;br&gt;&lt;br&gt;Every package above may name it, and it names none of them. Drawn apart because an arrow from each would say nothing an arrow from one does not.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=top;align=center;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=2;fontColor=#204d7d;spacingTop=12;spacingLeft=20;spacingRight=20;" parent="1" vertex="1">
                    <mxGeometry x="846" y="110" width="466" height="120" as="geometry"/>
                </mxCell>

                <mxCell id="g4" value="&lt;b style=&quot;font-size:16px&quot;&gt;tom_presentation&lt;/b&gt;&lt;div style=&quot;font-size:10px;font-weight:400;color:#9199a4&quot;&gt;pure Dart&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;one folder per feature&lt;br&gt;a notifier and a state per panel&lt;br&gt;the space session&lt;/div&gt;&lt;div style=&quot;font-size:11px;font-weight:400;color:#9199a4&quot;&gt;&lt;br&gt;no widget — it cannot see one&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=top;align=center;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=2;fontColor=#204d7d;spacingTop=14;spacingLeft=16;spacingRight=16;" parent="1" vertex="1">
