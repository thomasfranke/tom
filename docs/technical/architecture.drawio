                <mxCell id="d6" value="&lt;div style=&quot;font-size:9px;color:#5b7ea6&quot;&gt;DOMAIN&lt;/div&gt;&lt;b style=&quot;font-size:12px&quot;&gt;the document diff&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#41618a&quot;&gt;added · removed · changed&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#dfeaf6;strokeColor=#204d7d;strokeWidth=1.5;fontColor=#173a60;verticalAlign=middle;spacingLeft=10;spacingRight=10;" parent="1" vertex="1">
                    <mxGeometry x="1123" y="824" width="190" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="de1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9199a4;strokeWidth=1.4;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="d1" target="d2" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="de2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9199a4;strokeWidth=1.4;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="d2" target="d3" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="de3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9199a4;strokeWidth=1.4;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="d3" target="d4" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="de4" value="a port" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9199a4;strokeWidth=1.4;endArrow=blockThin;endFill=1;startArrow=blockThin;startFill=1;fontFamily=Helvetica;fontSize=10;fontColor=#6b7280;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="d4" target="d5" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="de5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9199a4;strokeWidth=1.4;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="d5" target="d6" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="ccap" value="&lt;b style=&quot;font-size:12px&quot;&gt;the diff is drawn over the formatted document, not beside it&lt;/b&gt;&lt;div style=&quot;font-size:10.5px;color:#6b7280&quot;&gt;What it is compared against lives on the session: HEAD, or a branch or commit the user chose. The compare surface offers the choice and reads no git of its own — the branches are the switcher's reading and the commits are the history panel's — and the preview listens to the base rather than watching it, so another base re-marks the text already on screen instead of parsing it again.&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f5f6f7;strokeColor=#9199a4;strokeWidth=1.5;fontColor=#565658;verticalAlign=middle;align=left;spacingLeft=18;spacingRight=18;" parent="1" vertex="1">
                    <mxGeometry x="48" y="934" width="1260" height="62" as="geometry"/>
                </mxCell>

                <mxCell id="fn" value="&lt;b&gt;A flow is missing on purpose.&lt;/b&gt; Full-text search exists in domain, application, data and infra — the repository, the use cases and the FTS5 capability — and has no panel yet, so it is not drawn as if a user could reach it.&lt;br&gt;&lt;span style=&quot;color:#9199a4&quot;&gt;An exception never crosses a boundary: every repository method and every use case answers with a Result, and the technical failure becomes a domain one in the repository and nowhere else.&lt;/span&gt;" style="text;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#6b7280;align=left;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="36" y="1024" width="1288" height="60" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
