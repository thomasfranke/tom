                    <mxGeometry x="580" y="280" width="200" height="290" as="geometry"/>
                </mxCell>
                <mxCell id="g7" value="&lt;b style=&quot;font-size:16px&quot;&gt;tom_data&lt;/b&gt;&lt;div style=&quot;font-size:10px;font-weight:400;color:#9199a4&quot;&gt;pure Dart&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;a repository per contract&lt;br&gt;a source per capability&lt;br&gt;the parsers and the DTOs&lt;/div&gt;&lt;div style=&quot;font-size:11px;font-weight:400;color:#9199a4&quot;&gt;&lt;br&gt;where the translation happens&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=top;align=center;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=2;fontColor=#204d7d;spacingTop=14;spacingLeft=16;spacingRight=16;" parent="1" vertex="1">
