                </mxCell>
                <mxCell id="lg2t" value="two-way · one layer in two packages" style="text;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#6b7280;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="470" y="950" width="280" height="16" as="geometry"/>
                </mxCell>
                <mxCell id="lg3" value="" style="endArrow=blockThin;endFill=1;html=1;strokeColor=#a9b6c8;strokeWidth=2;dashed=1;dashPattern=6 4;" parent="1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="792" y="958" as="sourcePoint"/>
                        <mxPoint x="830" y="958" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="lg3t" value="wiring · composition, not a rule" style="text;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#6b7280;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="842" y="950" width="280" height="16" as="geometry"/>
                </mxCell>

                <mxCell id="foot" value="Folder names are short; package names carry the tom_ prefix, because the folder is only a path while the package name is what every import says.&lt;br&gt;&lt;span style=&quot;color:#9199a4&quot;&gt;The table of who may depend on whom is in docs/technical/architecture.md, and the test that proves it is src/test/integrity/architecture_test.dart. When this drawing and the pubspecs disagree, the pubspecs are right.&lt;/span&gt;" style="text;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#6b7280;align=left;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="48" y="992" width="1264" height="48" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="tom-runtime-shell" name="Janela e módulos · TOM">
        <mxGraphModel dx="926" dy="257" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="1120" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="r1" value="TOM · THE WINDOW, THE MODULES AND WHAT THEY REACH" style="text;html=1;fontFamily=Helvetica;fontSize=10.5;fontStyle=1;fontColor=#6b7280;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="48" y="20" width="560" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="r2" value="every panel in the window was registered by a module — the app's own included, which is what keeps the extension point real" style="text;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#9199a4;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="48" y="42" width="900" height="18" as="geometry"/>
                </mxCell>

                <mxCell id="S1" value="STARTUP" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10.5;fontStyle=1;fillColor=#FFFFFF;strokeColor=#d7e0ec;strokeWidth=1.5;fontColor=#757475;verticalAlign=top;align=left;spacingLeft=20;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="36" y="80" width="1288" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="s1a" value="&lt;b style=&quot;font-size:12px&quot;&gt;main.dart&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#6b7280&quot;&gt;&lt;br&gt;one line: runTom()&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=1.5;fontColor=#204d7d;verticalAlign=middle;spacingLeft=12;spacingRight=12;" parent="1" vertex="1">
                    <mxGeometry x="48" y="118" width="216" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="s1b" value="&lt;b style=&quot;font-size:12px&quot;&gt;runTom(modules: […])&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#6b7280&quot;&gt;&lt;br&gt;title and minimum size, then runApp&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=1.5;fontColor=#204d7d;verticalAlign=middle;spacingLeft=12;spacingRight=12;" parent="1" vertex="1">
                    <mxGeometry x="310" y="118" width="216" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="s1c" value="&lt;b style=&quot;font-size:12px&quot;&gt;the app's module, then the rest&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#6b7280&quot;&gt;&lt;br&gt;each contributes panel descriptors and provider overrides&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f7fafd;strokeColor=#2d67a7;strokeWidth=1.5;fontColor=#204d7d;verticalAlign=middle;spacingLeft=12;spacingRight=12;" parent="1" vertex="1">
                    <mxGeometry x="572" y="118" width="216" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="s1d" value="&lt;b style=&quot;font-size:12px&quot;&gt;ProviderScope&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#6b7280&quot;&gt;&lt;br&gt;the registry, the app's wiring, then each module's — the last override wins&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f7fafd;strokeColor=#2d67a7;strokeWidth=1.5;fontColor=#204d7d;verticalAlign=middle;spacingLeft=12;spacingRight=12;" parent="1" vertex="1">
                    <mxGeometry x="834" y="118" width="216" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="s1e" value="&lt;b style=&quot;font-size:12px&quot;&gt;Home, then the shell&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#6b7280&quot;&gt;&lt;br&gt;a folder is picked, and the window opens on it&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=1.5;fontColor=#204d7d;verticalAlign=middle;spacingLeft=12;spacingRight=12;" parent="1" vertex="1">
                    <mxGeometry x="1096" y="118" width="216" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="se1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9199a4;strokeWidth=1.4;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s1a" target="s1b" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="se2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9199a4;strokeWidth=1.4;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s1b" target="s1c" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="se3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9199a4;strokeWidth=1.4;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s1c" target="s1d" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="se4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9199a4;strokeWidth=1.4;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="s1d" target="s1e" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>

                <mxCell id="S2" value="THE SHELL — the regions are a closed set; a panel is registered into one and never hardcoded" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10.5;fontStyle=1;fillColor=#FFFFFF;strokeColor=#d7e0ec;strokeWidth=1.5;fontColor=#757475;verticalAlign=top;align=left;spacingLeft=20;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="36" y="250" width="1288" height="400" as="geometry"/>
                </mxCell>
                <mxCell id="s2top" value="&lt;b style=&quot;font-size:12px&quot;&gt;top bar&lt;/b&gt;&lt;span style=&quot;font-size:10.5px;color:#6b7280&quot;&gt; — the space, the branch switcher, what the document is compared against, and fetch / push / pull. The shell's own, not a panel.&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f5f6f7;strokeColor=#9199a4;strokeWidth=1.5;fontColor=#565658;verticalAlign=middle;align=left;spacingLeft=18;spacingRight=18;" parent="1" vertex="1">
                    <mxGeometry x="60" y="296" width="1240" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="s2ex" value="&lt;div style=&quot;font-size:9px;color:#9199a4&quot;&gt;EXPLORER&lt;/div&gt;&lt;b style=&quot;font-size:12px&quot;&gt;the file tree&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#6b7280&quot;&gt;&lt;br&gt;the fixed column the space is navigated in&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=1.5;fontColor=#204d7d;verticalAlign=middle;spacingLeft=14;spacingRight=14;" parent="1" vertex="1">
                    <mxGeometry x="60" y="372" width="270" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="s2doc" value="&lt;div style=&quot;font-size:9px;color:#9199a4&quot;&gt;DOCUMENT — side by side, filtered by the mode the bar offers&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fafbfd;strokeColor=#d7e0ec;strokeWidth=1.5;fontColor=#204d7d;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="354" y="372" width="620" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="s2ed" value="&lt;b style=&quot;font-size:12px&quot;&gt;source&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#6b7280&quot;&gt;&lt;br&gt;re_editor · modes: source, split&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=1.5;fontColor=#204d7d;verticalAlign=middle;spacingLeft=14;spacingRight=14;" parent="1" vertex="1">
                    <mxGeometry x="366" y="404" width="290" height="104" as="geometry"/>
                </mxCell>
                <mxCell id="s2pv" value="&lt;b style=&quot;font-size:12px&quot;&gt;preview&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#6b7280&quot;&gt;&lt;br&gt;the rendered diff · modes: split, preview&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=1.5;fontColor=#204d7d;verticalAlign=middle;spacingLeft=14;spacingRight=14;" parent="1" vertex="1">
                    <mxGeometry x="676" y="404" width="290" height="104" as="geometry"/>
                </mxCell>
                <mxCell id="s2as" value="&lt;div style=&quot;font-size:9px;color:#9199a4&quot;&gt;ASIDE — git, and later search&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#fafbfd;strokeColor=#d7e0ec;strokeWidth=1.5;fontColor=#204d7d;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="998" y="372" width="302" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="s2ch" value="&lt;b style=&quot;font-size:12px&quot;&gt;changes&lt;/b&gt;&lt;span style=&quot;font-size:10px;color:#6b7280&quot;&gt; — stage, message, commit&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=1.5;fontColor=#204d7d;verticalAlign=middle;spacingLeft=14;spacingRight=14;" parent="1" vertex="1">
                    <mxGeometry x="1010" y="404" width="278" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="s2hi" value="&lt;b style=&quot;font-size:12px&quot;&gt;history&lt;/b&gt;&lt;span style=&quot;font-size:10px;color:#6b7280&quot;&gt; — this file's commits&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=1.5;fontColor=#204d7d;verticalAlign=middle;spacingLeft=14;spacingRight=14;" parent="1" vertex="1">
                    <mxGeometry x="1010" y="460" width="278" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="s2st" value="&lt;div style=&quot;font-size:9px;color:#9199a4;text-align:left&quot;&gt;STATUS BAR&lt;/div&gt;&lt;b style=&quot;font-size:12px&quot;&gt;status&lt;/b&gt;&lt;span style=&quot;font-size:10.5px;color:#6b7280&quot;&gt; — the strip that is read and never worked in&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=1.5;fontColor=#204d7d;verticalAlign=middle;align=left;spacingLeft=18;spacingRight=18;" parent="1" vertex="1">
                    <mxGeometry x="60" y="546" width="1240" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="s2note" value="A module adds to a region the shell already has and never invents one; it may override a provider, and it may not degrade what the app already does or need the network to start (Decision 12). Search will be another descriptor, in the aside." style="text;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#9199a4;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="606" width="1240" height="32" as="geometry"/>
                </mxCell>

                <mxCell id="S3" value="LIFETIMES — what the composition root keeps, and for how long" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10.5;fontStyle=1;fillColor=#FFFFFF;strokeColor=#d7e0ec;strokeWidth=1.5;fontColor=#757475;verticalAlign=top;align=left;spacingLeft=20;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="36" y="690" width="1288" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="s3a" value="&lt;b style=&quot;font-size:13px&quot;&gt;App · keepAlive&lt;/b&gt;&lt;div style=&quot;font-size:10.5px;color:#6b7280&quot;&gt;&lt;br&gt;the parsers, the diff service, Observability, the settings — one instance for the process&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#eef3f9;strokeColor=#a9c0da;strokeWidth=1.5;fontColor=#204d7d;verticalAlign=middle;spacingLeft=18;spacingRight=18;" parent="1" vertex="1">
                    <mxGeometry x="48" y="730" width="400" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="s3b" value="&lt;b style=&quot;font-size:13px&quot;&gt;Space · a family keyed by the root&lt;/b&gt;&lt;div style=&quot;font-size:10.5px;color:#6b7280&quot;&gt;&lt;br&gt;the git client and its queue, the watcher, the FTS5 index and the session — closing the space disposes of them&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#dfeaf6;strokeColor=#204d7d;strokeWidth=1.5;fontColor=#173a60;verticalAlign=middle;spacingLeft=18;spacingRight=18;" parent="1" vertex="1">
                    <mxGeometry x="480" y="730" width="400" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="s3c" value="&lt;b style=&quot;font-size:13px&quot;&gt;Transient&lt;/b&gt;&lt;div style=&quot;font-size:10.5px;color:#6b7280&quot;&gt;&lt;br&gt;the use cases — lightweight objects, created where they are used and kept by nobody&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#eef3f9;strokeColor=#a9c0da;strokeWidth=1.5;fontColor=#204d7d;verticalAlign=middle;spacingLeft=18;spacingRight=18;" parent="1" vertex="1">
                    <mxGeometry x="912" y="730" width="400" height="110" as="geometry"/>
                </mxCell>

                <mxCell id="S4" value="WHAT IT REACHES ON THE MACHINE" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10.5;fontStyle=1;fillColor=#f5f6f7;strokeColor=#dcdfe3;dashed=1;dashPattern=4 3;strokeWidth=1.5;fontColor=#9199a4;verticalAlign=top;align=left;spacingLeft=20;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="36" y="900" width="1288" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="s4a" value="&lt;b style=&quot;font-size:12px&quot;&gt;the git binary&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#6b7280&quot;&gt;&lt;br&gt;Process.run, through one serialized queue per space: no commit during a checkout&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#9199a4;strokeWidth=1.5;fontColor=#565658;verticalAlign=middle;spacingLeft=14;spacingRight=14;" parent="1" vertex="1">
                    <mxGeometry x="48" y="944" width="232" height="98" as="geometry"/>
                </mxCell>
                <mxCell id="s4b" value="&lt;b style=&quot;font-size:12px&quot;&gt;the space folder&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#6b7280&quot;&gt;&lt;br&gt;the .md files are the truth; the watcher is paused around every mutation (Decision 10)&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#9199a4;strokeWidth=1.5;fontColor=#565658;verticalAlign=middle;spacingLeft=14;spacingRight=14;" parent="1" vertex="1">
                    <mxGeometry x="306" y="944" width="232" height="98" as="geometry"/>
                </mxCell>
                <mxCell id="s4c" value="&lt;b style=&quot;font-size:12px&quot;&gt;settings, as JSON&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#6b7280&quot;&gt;&lt;br&gt;the recent spaces and the preferences, under the platform's app-support path&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#9199a4;strokeWidth=1.5;fontColor=#565658;verticalAlign=middle;spacingLeft=14;spacingRight=14;" parent="1" vertex="1">
                    <mxGeometry x="564" y="944" width="232" height="98" as="geometry"/>
                </mxCell>
                <mxCell id="s4d" value="&lt;b style=&quot;font-size:12px&quot;&gt;the FTS5 index&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#6b7280&quot;&gt;&lt;br&gt;a cache and nothing else: corrupted or gone, it is rebuilt by reading the files again&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#9199a4;strokeWidth=1.5;fontColor=#565658;verticalAlign=middle;spacingLeft=14;spacingRight=14;" parent="1" vertex="1">
                    <mxGeometry x="822" y="944" width="232" height="98" as="geometry"/>
                </mxCell>
                <mxCell id="s4e" value="&lt;b style=&quot;font-size:12px&quot;&gt;a remote&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#6b7280&quot;&gt;&lt;br&gt;reached only by the user's own git — their credentials, their keys, their config; TOM implements none of it&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#efefef;strokeColor=#b9c4d4;strokeWidth=1.5;dashed=1;dashPattern=5 4;fontColor=#565658;verticalAlign=middle;spacingLeft=14;spacingRight=14;" parent="1" vertex="1">
                    <mxGeometry x="1080" y="944" width="232" height="98" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="tom-flows" name="Fluxos · TOM">
        <mxGraphModel dx="926" dy="257" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="1110" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t1" value="TOM · THE FLOWS THAT CROSS EVERY LAYER" style="text;html=1;fontFamily=Helvetica;fontSize=10.5;fontStyle=1;fontColor=#6b7280;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="48" y="20" width="480" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="t2" value="nothing happens in the background — the user opens a folder, commits, or asks what changed; between those, the files on disk are the only source of truth" style="text;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#9199a4;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="48" y="42" width="980" height="18" as="geometry"/>
                </mxCell>

                <mxCell id="L1" value="1 · OPEN A SPACE" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10.5;fontStyle=1;fillColor=#FFFFFF;strokeColor=#d7e0ec;strokeWidth=1.5;fontColor=#757475;verticalAlign=top;align=left;spacingLeft=20;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="36" y="80" width="1288" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="a1" value="&lt;div style=&quot;font-size:9px;color:#9199a4&quot;&gt;DESKTOP&lt;/div&gt;&lt;b style=&quot;font-size:12px&quot;&gt;Home&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#6b7280&quot;&gt;the folder picker&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=1.5;fontColor=#204d7d;verticalAlign=middle;spacingLeft=10;spacingRight=10;" parent="1" vertex="1">
                    <mxGeometry x="48" y="124" width="150" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="a2" value="&lt;div style=&quot;font-size:9px;color:#9199a4&quot;&gt;PRESENTATION&lt;/div&gt;&lt;b style=&quot;font-size:12px&quot;&gt;the home notifier&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=1.5;fontColor=#204d7d;verticalAlign=middle;spacingLeft=10;spacingRight=10;" parent="1" vertex="1">
                    <mxGeometry x="233" y="124" width="150" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="a3" value="&lt;div style=&quot;font-size:9px;color:#9199a4&quot;&gt;APPLICATION&lt;/div&gt;&lt;b style=&quot;font-size:12px&quot;&gt;open the space&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f7fafd;strokeColor=#2d67a7;strokeWidth=1.5;fontColor=#204d7d;verticalAlign=middle;spacingLeft=10;spacingRight=10;" parent="1" vertex="1">
                    <mxGeometry x="418" y="124" width="150" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="a4" value="&lt;div style=&quot;font-size:9px;color:#9199a4&quot;&gt;DATA&lt;/div&gt;&lt;b style=&quot;font-size:12px&quot;&gt;the space repository&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#6b7280&quot;&gt;translates the failure&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#8aa3bf;strokeWidth=1.5;fontColor=#41618a;verticalAlign=middle;spacingLeft=10;spacingRight=10;" parent="1" vertex="1">
                    <mxGeometry x="603" y="124" width="150" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="a5" value="&lt;div style=&quot;font-size:9px;color:#9199a4&quot;&gt;DATA&lt;/div&gt;&lt;b style=&quot;font-size:12px&quot;&gt;the space source&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#8aa3bf;strokeWidth=1.5;fontColor=#41618a;verticalAlign=middle;spacingLeft=10;spacingRight=10;" parent="1" vertex="1">
                    <mxGeometry x="788" y="124" width="150" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="a6" value="&lt;div style=&quot;font-size:9px;color:#9199a4&quot;&gt;INFRA&lt;/div&gt;&lt;b style=&quot;font-size:12px&quot;&gt;filesystem · git client&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#6b7280&quot;&gt;dart_io&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#8aa3bf;strokeWidth=1.5;fontColor=#41618a;verticalAlign=middle;spacingLeft=10;spacingRight=10;" parent="1" vertex="1">
                    <mxGeometry x="973" y="124" width="150" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="a7" value="&lt;div style=&quot;font-size:9px;color:#9199a4&quot;&gt;THE MACHINE&lt;/div&gt;&lt;b style=&quot;font-size:12px&quot;&gt;the folder&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#6b7280&quot;&gt;git rev-parse&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f5f6f7;strokeColor=#9199a4;strokeWidth=1.5;fontColor=#565658;verticalAlign=middle;spacingLeft=10;spacingRight=10;" parent="1" vertex="1">
                    <mxGeometry x="1158" y="124" width="150" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="ae1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9199a4;strokeWidth=1.4;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="a1" target="a2" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="ae2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9199a4;strokeWidth=1.4;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="a2" target="a3" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="ae3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9199a4;strokeWidth=1.4;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="a3" target="a4" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="ae4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9199a4;strokeWidth=1.4;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="a4" target="a5" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="ae5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9199a4;strokeWidth=1.4;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="a5" target="a6" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="ae6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9199a4;strokeWidth=1.4;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="a6" target="a7" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="acap" value="the answer is a &lt;b&gt;space entity&lt;/b&gt; carrying its &lt;i&gt;root&lt;/i&gt; and its &lt;i&gt;repository root&lt;/i&gt; separately — a space is a folder, not a repository — and the session opens on it. A folder with no repository is offered &lt;i&gt;git init&lt;/i&gt;, or runs degraded: editing and preview only." style="text;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#6b7280;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="48" y="232" width="1260" height="44" as="geometry"/>
                </mxCell>

                <mxCell id="L2" value="2 · COMMIT" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10.5;fontStyle=1;fillColor=#FFFFFF;strokeColor=#d7e0ec;strokeWidth=1.5;fontColor=#757475;verticalAlign=top;align=left;spacingLeft=20;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="36" y="340" width="1288" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="b1" value="&lt;div style=&quot;font-size:9px;color:#9199a4&quot;&gt;DESKTOP&lt;/div&gt;&lt;b style=&quot;font-size:12px&quot;&gt;the changes panel&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#6b7280&quot;&gt;the message box&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=1.5;fontColor=#204d7d;verticalAlign=middle;spacingLeft=10;spacingRight=10;" parent="1" vertex="1">
