                </mxCell>
                <mxCell id="b2" value="&lt;div style=&quot;font-size:9px;color:#9199a4&quot;&gt;PRESENTATION&lt;/div&gt;&lt;b style=&quot;font-size:12px&quot;&gt;the changes notifier&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=1.5;fontColor=#204d7d;verticalAlign=middle;spacingLeft=10;spacingRight=10;" parent="1" vertex="1">
                    <mxGeometry x="233" y="384" width="150" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="b3" value="&lt;div style=&quot;font-size:9px;color:#9199a4&quot;&gt;APPLICATION&lt;/div&gt;&lt;b style=&quot;font-size:12px&quot;&gt;stage, then commit&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f7fafd;strokeColor=#2d67a7;strokeWidth=1.5;fontColor=#204d7d;verticalAlign=middle;spacingLeft=10;spacingRight=10;" parent="1" vertex="1">
