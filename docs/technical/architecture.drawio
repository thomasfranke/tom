                    <mxGeometry x="1158" y="384" width="150" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="be1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9199a4;strokeWidth=1.4;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="b1" target="b2" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="be2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9199a4;strokeWidth=1.4;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="b2" target="b3" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="be3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9199a4;strokeWidth=1.4;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="b3" target="b4" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="be4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9199a4;strokeWidth=1.4;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="b4" target="b5" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="be5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9199a4;strokeWidth=1.4;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="b5" target="b6" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="be6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9199a4;strokeWidth=1.4;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="b6" target="b7" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="b8" value="&lt;b style=&quot;font-size:12px&quot;&gt;the watcher goes quiet around the mutation, and one change event is emitted at the end&lt;/b&gt;&lt;div style=&quot;font-size:10.5px;color:#6b7280&quot;&gt;Pause and resume enter the same queue, which is what guarantees the ordering (Decision 10). The session re-reads the status, and every panel derived from it redraws — no scattered invalidation.&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#f5f6f7;strokeColor=#9199a4;strokeWidth=1.5;fontColor=#565658;verticalAlign=middle;align=left;spacingLeft=18;spacingRight=18;" parent="1" vertex="1">
                    <mxGeometry x="48" y="496" width="1260" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="be7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9199a4;strokeWidth=1.4;endArrow=blockThin;endFill=1;dashed=1;dashPattern=5 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" parent="1" source="b6" target="b8" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="bcap" value="a rejected push keeps the message box's place and says so there; a divergent pull is refused rather than guessed at — git's own words, turned into a domain failure by the repository." style="text;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#6b7280;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="48" y="568" width="1260" height="34" as="geometry"/>
                </mxCell>

                <mxCell id="L3" value="3 · THE RENDERED DIFF — what the product is actually for" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10.5;fontStyle=1;fillColor=#FFFFFF;strokeColor=#d7e0ec;strokeWidth=1.5;fontColor=#757475;verticalAlign=top;align=left;spacingLeft=20;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="36" y="660" width="1288" height="340" as="geometry"/>
                </mxCell>
