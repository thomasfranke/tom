                <mxCell id="ge8" value="the contracts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2d67a7;strokeWidth=2;endArrow=blockThin;endFill=1;fontFamily=Helvetica;fontSize=10.5;fontColor=#6b7280;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" parent="1" source="g7" target="g8" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
