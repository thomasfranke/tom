                    <mxGeometry x="603" y="384" width="150" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="b5" value="&lt;div style=&quot;font-size:9px;color:#9199a4&quot;&gt;DATA&lt;/div&gt;&lt;b style=&quot;font-size:12px&quot;&gt;the git source&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#6b7280&quot;&gt;text, never an entity&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#8aa3bf;strokeWidth=1.5;fontColor=#41618a;verticalAlign=middle;spacingLeft=10;spacingRight=10;" parent="1" vertex="1">
                    <mxGeometry x="788" y="384" width="150" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="b6" value="&lt;div style=&quot;font-size:9px;color:#9199a4&quot;&gt;INFRA&lt;/div&gt;&lt;b style=&quot;font-size:12px&quot;&gt;the git client&lt;/b&gt;&lt;div style=&quot;font-size:10px;color:#6b7280&quot;&gt;the serialized queue&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#8aa3bf;strokeWidth=1.5;fontColor=#41618a;verticalAlign=middle;spacingLeft=10;spacingRight=10;" parent="1" vertex="1">
