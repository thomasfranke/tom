<mxfile host="65bd71144e">
    <diagram id="tom-packages-boundaries" name="Packages · TOM">
        <mxGraphModel dx="926" dy="257" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="1580" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="TOM" style="text;html=1;fontFamily=Helvetica;fontSize=30;fontStyle=1;fontColor=#204d7d;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="24" width="500" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="The packages, and what crosses each boundary" style="text;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#6b7280;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="68" width="700" height="24" as="geometry"/>
                </mxCell>

                <mxCell id="d0" value="&lt;b style=&quot;font-size:16px&quot;&gt;tom_domain&lt;/b&gt;&lt;div style=&quot;font-size:11px;font-weight:400;color:#41618a&quot;&gt;&lt;br&gt;The rules. Depends on tom_core and on nothing else.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=top;align=center;fillColor=#dfeaf6;strokeColor=#204d7d;strokeWidth=2.5;fontColor=#173a60;spacingLeft=20;spacingRight=20;spacingTop=18;" parent="1" vertex="1">
                    <mxGeometry x="390" y="130" width="320" height="600" as="geometry"/>
                </mxCell>
                <mxCell id="d1" value="&lt;b style=&quot;font-size:13px&quot;&gt;Entities · Value Objects&lt;/b&gt;&lt;div style=&quot;font-size:10.5px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;The space, the document, the commit and the branch — and the typed paths, the revision and the block. Freezed, or an extension type when the shape is one field (Decision 16).&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#a9c0da;strokeWidth=1.5;fontColor=#204d7d;spacingLeft=16;spacingRight=16;spacingTop=6;spacingBottom=6;" parent="d0" vertex="1">
                    <mxGeometry x="20" y="92" width="280" height="124" as="geometry"/>
                </mxCell>
                <mxCell id="d2" value="&lt;b style=&quot;font-size:13px&quot;&gt;Repository contracts · Ports&lt;/b&gt;&lt;div style=&quot;font-size:10.5px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;What the data layer implements — git, documents, spaces, recent spaces, search — plus the ports the domain reads blocks and alignments through.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#a9c0da;strokeWidth=1.5;fontColor=#204d7d;spacingLeft=16;spacingRight=16;spacingTop=6;spacingBottom=6;" parent="d0" vertex="1">
                    <mxGeometry x="20" y="236" width="280" height="112" as="geometry"/>
                </mxCell>
                <mxCell id="d3" value="&lt;b style=&quot;font-size:13px&quot;&gt;Sealed failures&lt;/b&gt;&lt;div style=&quot;font-size:10.5px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;One hierarchy per area, sealed inside its own library, so a switch that misses a variant does not compile (Decision 5).&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#a9c0da;strokeWidth=1.5;fontColor=#204d7d;spacingLeft=16;spacingRight=16;spacingTop=6;spacingBottom=6;" parent="d0" vertex="1">
                    <mxGeometry x="20" y="368" width="280" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="d4" value="&lt;b style=&quot;font-size:13px&quot;&gt;BlockDifferService&lt;/b&gt;&lt;div style=&quot;font-size:10.5px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;The domain service behind the rendered diff: aligns blocks by position, pairs them by word similarity (Decision 27).&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#a9c0da;strokeWidth=1.5;fontColor=#204d7d;spacingLeft=16;spacingRight=16;spacingTop=6;spacingBottom=6;" parent="d0" vertex="1">
                    <mxGeometry x="20" y="488" width="280" height="92" as="geometry"/>
                </mxCell>

                <mxCell id="a0" value="&lt;b style=&quot;font-size:16px&quot;&gt;tom_application&lt;/b&gt;&lt;div style=&quot;font-size:11.5px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;One use case per product action. Each composes repositories and the domain service over the UseCase mixin, which holds the standardised try/catch: what it catches goes to Observability and comes back as an UnexpectedFailure.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=2;fontColor=#204d7d;spacingLeft=18;spacingRight=18;spacingTop=8;spacingBottom=8;" parent="1" vertex="1">
                    <mxGeometry x="40" y="190" width="280" height="200" as="geometry"/>
                </mxCell>

                <mxCell id="p0" value="&lt;b style=&quot;font-size:16px&quot;&gt;tom_presentation&lt;/b&gt;&lt;div style=&quot;font-size:11px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;Pure Dart — it cannot reach a widget.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=top;align=center;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=2;fontColor=#204d7d;spacingLeft=20;spacingRight=20;spacingTop=18;" parent="1" vertex="1">
                    <mxGeometry x="40" y="480" width="280" height="436" as="geometry"/>
                </mxCell>
                <mxCell id="p1" value="&lt;b style=&quot;font-size:13px&quot;&gt;Space session&lt;/b&gt;&lt;div style=&quot;font-size:10.5px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;One per open space: the space, the open document, the mode, the git status, the version being read and what it is compared against. Panels derive from it with select (Decision 9).&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;align=center;fillColor=#eef3f9;strokeColor=#a9c0da;strokeWidth=1.5;fontColor=#204d7d;spacingLeft=16;spacingRight=16;spacingTop=6;spacingBottom=6;" parent="p0" vertex="1">
                    <mxGeometry x="20" y="92" width="240" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="p2" value="&lt;b style=&quot;font-size:13px&quot;&gt;Notifiers&lt;/b&gt;&lt;div style=&quot;font-size:10.5px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;One per panel, with an explicit state: initial / loading / data / error. No business logic — it calls a use case and turns the Result into state.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;align=center;fillColor=#eef3f9;strokeColor=#a9c0da;strokeWidth=1.5;fontColor=#204d7d;spacingLeft=16;spacingRight=16;spacingTop=6;spacingBottom=6;" parent="p0" vertex="1">
                    <mxGeometry x="20" y="256" width="240" height="140" as="geometry"/>
                </mxCell>

                <mxCell id="t0" value="&lt;b style=&quot;font-size:16px&quot;&gt;tom_data&lt;/b&gt;&lt;div style=&quot;font-size:11px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;What the domain asked for: obtained, parsed, translated.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=top;align=center;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=2;fontColor=#204d7d;spacingLeft=20;spacingRight=20;spacingTop=18;" parent="1" vertex="1">
                    <mxGeometry x="780" y="130" width="380" height="404" as="geometry"/>
                </mxCell>
                <mxCell id="t1" value="&lt;b style=&quot;font-size:13px&quot;&gt;Repositories&lt;/b&gt;&lt;div style=&quot;font-size:10.5px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;Orchestrate and translate. The one place a technical failure becomes a domain one (Decision 25).&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;align=center;fillColor=#eef3f9;strokeColor=#a9c0da;strokeWidth=1.5;fontColor=#204d7d;spacingLeft=14;spacingRight=14;spacingTop=6;spacingBottom=6;" parent="t0" vertex="1">
                    <mxGeometry x="20" y="96" width="165" height="116" as="geometry"/>
                </mxCell>
                <mxCell id="t2" value="&lt;b style=&quot;font-size:13px&quot;&gt;Parsers&lt;/b&gt;&lt;div style=&quot;font-size:10.5px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;Read what git printed. They belong to the repository, never to the source.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;align=center;fillColor=#eef3f9;strokeColor=#a9c0da;strokeWidth=1.5;fontColor=#204d7d;spacingLeft=14;spacingRight=14;spacingTop=6;spacingBottom=6;" parent="t0" vertex="1">
                    <mxGeometry x="195" y="96" width="165" height="116" as="geometry"/>
                </mxCell>
                <mxCell id="t3" value="&lt;b style=&quot;font-size:13px&quot;&gt;Data sources&lt;/b&gt;&lt;div style=&quot;font-size:10.5px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;Obtain, never interpret: one call per capability method, one instance per space.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;align=center;fillColor=#eef3f9;strokeColor=#a9c0da;strokeWidth=1.5;fontColor=#204d7d;spacingLeft=16;spacingRight=16;spacingTop=6;spacingBottom=6;" parent="t0" vertex="1">
                    <mxGeometry x="20" y="232" width="340" height="68" as="geometry"/>
                </mxCell>
                <mxCell id="t4" value="&lt;b style=&quot;font-size:13px&quot;&gt;DTOs&lt;/b&gt;&lt;div style=&quot;font-size:10.5px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;The shapes that cross the capability contracts, declared here because the capability answers with them (Decision 21).&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#a9c0da;strokeWidth=1.5;fontColor=#204d7d;spacingLeft=16;spacingRight=16;spacingTop=6;spacingBottom=6;" parent="t0" vertex="1">
                    <mxGeometry x="20" y="316" width="340" height="68" as="geometry"/>
                </mxCell>

                <mxCell id="i0" value="&lt;b style=&quot;font-size:16px&quot;&gt;tom_infra&lt;/b&gt;&lt;div style=&quot;font-size:11px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;A capability is a folder: the contract, its failures, and one implementation per dependency, named after it (Decision 24). It never depends on tom_domain — which is what makes the translation above mandatory rather than customary.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=top;align=center;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=2;fontColor=#204d7d;spacingLeft=20;spacingRight=20;spacingTop=18;" parent="1" vertex="1">
                    <mxGeometry x="780" y="610" width="380" height="378" as="geometry"/>
                </mxCell>
                <mxCell id="i1" value="&lt;b style=&quot;font-size:12px&quot;&gt;git_client/ · dart_io&lt;/b&gt;&lt;div style=&quot;font-size:10px;font-weight:400;color:#6b7280&quot;&gt;Process.run, one serialized queue per space&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;align=center;fillColor=#eef3f9;strokeColor=#a9c0da;strokeWidth=1.5;fontColor=#204d7d;spacingLeft=14;spacingRight=14;spacingTop=4;spacingBottom=4;" parent="i0" vertex="1">
                    <mxGeometry x="20" y="120" width="165" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="i2" value="&lt;b style=&quot;font-size:12px&quot;&gt;filesystem/ · dart_io&lt;/b&gt;&lt;div style=&quot;font-size:10px;font-weight:400;color:#6b7280&quot;&gt;reading, writing and walking the space&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;align=center;fillColor=#eef3f9;strokeColor=#a9c0da;strokeWidth=1.5;fontColor=#204d7d;spacingLeft=14;spacingRight=14;spacingTop=4;spacingBottom=4;" parent="i0" vertex="1">
                    <mxGeometry x="195" y="120" width="165" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="i3" value="&lt;b style=&quot;font-size:12px&quot;&gt;markdown_parser/ · markdown&lt;/b&gt;&lt;div style=&quot;font-size:10px;font-weight:400;color:#6b7280&quot;&gt;the blocks, as spans (Decision 19)&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;align=center;fillColor=#eef3f9;strokeColor=#a9c0da;strokeWidth=1.5;fontColor=#204d7d;spacingLeft=14;spacingRight=14;spacingTop=4;spacingBottom=4;" parent="i0" vertex="1">
                    <mxGeometry x="20" y="182" width="165" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="i4" value="&lt;b style=&quot;font-size:12px&quot;&gt;text_differ/ · diffutil&lt;/b&gt;&lt;div style=&quot;font-size:10px;font-weight:400;color:#6b7280&quot;&gt;Myers over lists: positions, not verdicts&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;align=center;fillColor=#eef3f9;strokeColor=#a9c0da;strokeWidth=1.5;fontColor=#204d7d;spacingLeft=14;spacingRight=14;spacingTop=4;spacingBottom=4;" parent="i0" vertex="1">
                    <mxGeometry x="195" y="182" width="165" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="i5" value="&lt;b style=&quot;font-size:12px&quot;&gt;search_index/ · sqlite3&lt;/b&gt;&lt;div style=&quot;font-size:10px;font-weight:400;color:#6b7280&quot;&gt;FTS5 — a cache, rebuilt from the files&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;align=center;fillColor=#eef3f9;strokeColor=#a9c0da;strokeWidth=1.5;fontColor=#204d7d;spacingLeft=14;spacingRight=14;spacingTop=4;spacingBottom=4;" parent="i0" vertex="1">
                    <mxGeometry x="20" y="244" width="165" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="i6" value="&lt;b style=&quot;font-size:12px&quot;&gt;settings/ · json_file&lt;/b&gt;&lt;div style=&quot;font-size:10px;font-weight:400;color:#6b7280&quot;&gt;the recent spaces and the preferences&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;align=center;fillColor=#eef3f9;strokeColor=#a9c0da;strokeWidth=1.5;fontColor=#204d7d;spacingLeft=14;spacingRight=14;spacingTop=4;spacingBottom=4;" parent="i0" vertex="1">
                    <mxGeometry x="195" y="244" width="165" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="i7" value="&lt;b style=&quot;font-size:12px&quot;&gt;platform_paths/ · dart_io&lt;/b&gt;&lt;span style=&quot;font-size:10px;font-weight:400;color:#6b7280&quot;&gt; — where the app may write on each platform, the only thing below that knows there is more than one&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;align=center;fillColor=#eef3f9;strokeColor=#a9c0da;strokeWidth=1.5;fontColor=#204d7d;spacingLeft=16;spacingRight=16;spacingTop=4;spacingBottom=4;" parent="i0" vertex="1">
                    <mxGeometry x="20" y="306" width="340" height="52" as="geometry"/>
                </mxCell>

                <mxCell id="fline" value="— the Flutter line: the packages above run under &lt;i&gt;dart test&lt;/i&gt;, with no binding available —" style="text;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#9199a4;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="40" y="940" width="670" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="f1" value="&lt;b style=&quot;font-size:16px&quot;&gt;apps/desktop&lt;/b&gt;&lt;div style=&quot;font-size:11px;font-weight:400;color:#6b7280&quot;&gt;Flutter&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;The composition root, the shell, and screens/&amp;lt;feature&amp;gt;/ mirroring tom_presentation. Panels are registered through TomModule, never hardcoded — the built-in ones included (Decision 12).&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=2;fontColor=#204d7d;spacingLeft=18;spacingRight=18;spacingTop=8;spacingBottom=8;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1000" width="280" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="f2" value="&lt;b style=&quot;font-size:16px&quot;&gt;tom_ui&lt;/b&gt;&lt;div style=&quot;font-size:11px;font-weight:400;color:#6b7280&quot;&gt;Flutter&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;The look both applications draw: colour roles, metrics, the brand marks and the shared components. It depends on no package and wires nothing — a screen is the application's, what it is drawn with is not (Decision 26).&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=2;fontColor=#204d7d;spacingLeft=20;spacingRight=20;spacingTop=8;spacingBottom=8;" parent="1" vertex="1">
                    <mxGeometry x="390" y="1000" width="320" height="210" as="geometry"/>
                </mxCell>

                <mxCell id="env1" value="&lt;b style=&quot;font-size:15px&quot;&gt;The machine&lt;/b&gt;&lt;div style=&quot;font-size:11.5px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;the user's own git binary&lt;br&gt;the folder they opened · the .md files&lt;br&gt;settings, as JSON under the app-support path&lt;br&gt;the FTS5 index file&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;align=center;fillColor=#f5f6f7;strokeColor=#9199a4;strokeWidth=2;fontColor=#565658;spacingLeft=16;spacingRight=16;spacingTop=8;spacingBottom=8;" parent="1" vertex="1">
                    <mxGeometry x="780" y="1060" width="180" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="env2" value="&lt;b style=&quot;font-size:15px&quot;&gt;Beyond it&lt;/b&gt;&lt;div style=&quot;font-size:11.5px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;A remote, reached only by the user's own git: their credentials, their SSH keys, their config. TOM implements no authentication, and nothing leaves the machine (Decision 11).&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;align=center;fillColor=#efefef;strokeColor=#b9c4d4;strokeWidth=2;dashed=1;dashPattern=6 4;fontColor=#565658;spacingLeft=16;spacingRight=16;spacingTop=8;spacingBottom=8;" parent="1" vertex="1">
                    <mxGeometry x="980" y="1060" width="180" height="160" as="geometry"/>
                </mxCell>

                <mxCell id="x1" style="startArrow=blockThin;startFill=1;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2d67a7;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="p0" target="a0" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="x2" style="startArrow=blockThin;startFill=1;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2d67a7;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.267;entryDx=0;entryDy=0;" parent="1" source="a0" target="d0" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="x3" value="Entities /&lt;br&gt;Domain Failures" style="startArrow=blockThin;startFill=1;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2d67a7;strokeWidth=2;endArrow=blockThin;endFill=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#204d7d;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="t1" target="d2" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="x4" style="startArrow=blockThin;startFill=1;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2d67a7;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" parent="1" source="t1" target="t3" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="x5" style="startArrow=blockThin;startFill=1;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2d67a7;strokeWidth=2;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" parent="1" source="t2" target="t3" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="x6" value="DTO / Capability Failure" style="startArrow=blockThin;startFill=1;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2d67a7;strokeWidth=2;endArrow=blockThin;endFill=1;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#204d7d;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="t0" target="i0" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="x7" value="stdout · exit code · bytes" style="startArrow=blockThin;startFill=1;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2d67a7;strokeWidth=2;endArrow=blockThin;endFill=1;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#204d7d;labelBackgroundColor=#FFFFFF;exitX=0.24;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="i0" target="env1" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="x8" value="fetch · push" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9199a4;strokeWidth=2;endArrow=blockThin;endFill=1;startArrow=blockThin;startFill=1;dashed=1;dashPattern=6 4;fontFamily=Helvetica;fontSize=11;fontColor=#6b7280;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="env1" target="env2" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="x9" value="watch · read" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2d67a7;strokeWidth=2;endArrow=blockThin;endFill=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#204d7d;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="f1" target="p0" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="x10" value="draws with" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2d67a7;strokeWidth=2;endArrow=blockThin;endFill=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#204d7d;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="f1" target="f2" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>

                <mxCell id="core" value="&lt;b style=&quot;font-size:15px&quot;&gt;tom_core&lt;/b&gt;&lt;div style=&quot;font-size:11.5px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;Mechanism, never product vocabulary: Result, the AppFailure marker and the ports every layer needs. The only package all the others are allowed to name.&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;align=center;fillColor=#FFFFFF;strokeColor=#2d67a7;strokeWidth=2;fontColor=#204d7d;spacingLeft=24;spacingRight=24;spacingTop=10;spacingBottom=10;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1270" width="1120" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="di" value="&lt;b style=&quot;font-size:15px&quot;&gt;Riverpod · composition, not a layer&lt;/b&gt;&lt;div style=&quot;font-size:11.5px;font-weight:400;color:#6b7280&quot;&gt;&lt;br&gt;Providers live in tom_presentation and in the composition root, nowhere else (Decision 7). Everything below takes its dependencies through its constructor, which is what makes any of it substitutable in a test. The lifetimes: app (keepAlive), space (a family keyed by the root — the git queue, the watcher, the index, the session), transient (the use cases).&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;align=center;fillColor=#f5f6f7;strokeColor=#9199a4;strokeWidth=1.5;dashed=1;dashPattern=8 5;fontColor=#565658;spacingLeft=24;spacingRight=24;spacingTop=10;spacingBottom=10;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1410" width="1120" height="110" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="tom-dependencies" name="Dependências · TOM">
        <mxGraphModel dx="926" dy="257" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="1060" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="h1" value="TOM · WHAT EACH PACKAGE MAY DEPEND ON" style="text;html=1;fontFamily=Helvetica;fontSize=10.5;fontStyle=1;fontColor=#6b7280;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="48" y="20" width="480" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="h2" value="the graph the pubspecs declare — a violation does not resolve, rather than being noticed in review" style="text;html=1;fontFamily=Helvetica;fontSize=11.5;fontColor=#9199a4;align=left;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="48" y="42" width="800" height="18" as="geometry"/>
