                <mxCell id="ge10" value="the one two-way edge: two packages, one layer (Decision 24)" style="text;html=1;fontFamily=Helvetica;fontSize=10.5;fontColor=#9199a4;align=center;verticalAlign=middle;" parent="1" vertex="1">
