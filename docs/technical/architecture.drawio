                <mxCell id="pa0" value="WHAT ENFORCES IT" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10.5;fontStyle=1;fillColor=#f5f6f7;strokeColor=#dcdfe3;dashed=1;dashPattern=4 3;strokeWidth=1.5;fontColor=#9199a4;verticalAlign=top;align=left;spacingLeft=20;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="48" y="680" width="630" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="pa1" value="&lt;b&gt;the pubspecs&lt;/b&gt; — an import of a package the layer never declared does not resolve" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#eef3f9;strokeColor=#d7e0ec;fontColor=#204d7d;align=left;spacingLeft=16;spacingRight=16;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="68" y="718" width="590" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="pa2" value="&lt;b&gt;depend_on_referenced_packages: error&lt;/b&gt; — the same import arriving through a transitive dependency" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#eef3f9;strokeColor=#d7e0ec;fontColor=#204d7d;align=left;spacingLeft=16;spacingRight=16;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="68" y="766" width="590" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="pa3" value="&lt;b&gt;implementation_imports: error&lt;/b&gt; — reaching into another package's lib/src/ instead of its barrel" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#eef3f9;strokeColor=#d7e0ec;fontColor=#204d7d;align=left;spacingLeft=16;spacingRight=16;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="68" y="814" width="590" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="pa4" value="&lt;b&gt;src/test/integrity/architecture_test.dart&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#6b7280&quot;&gt;what no pubspec can express: a dependency simply added to one, an SDK library like dart:io, a Flutter package in dev_dependencies&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#eef3f9;strokeColor=#d7e0ec;fontColor=#204d7d;align=left;spacingLeft=16;spacingRight=16;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="68" y="862" width="590" height="42" as="geometry"/>
                </mxCell>

                <mxCell id="pb0" value="WHAT THAT BUYS" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=10.5;fontStyle=1;fillColor=#f6faf7;strokeColor=#c6ddcd;dashed=1;dashPattern=4 3;strokeWidth=1.5;fontColor=#1d6b3f;verticalAlign=top;align=left;spacingLeft=20;spacingTop=10;" parent="1" vertex="1">
                    <mxGeometry x="730" y="680" width="582" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="pb1" value="&lt;b&gt;nothing imports upwards&lt;/b&gt;&lt;span style=&quot;color:#6b7280&quot;&gt; — every edge above points at a lower layer&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#c6ddcd;fontColor=#1d6b3f;align=left;spacingLeft=16;spacingRight=16;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="750" y="718" width="542" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="pb2" value="&lt;b&gt;only the composition root sees an implementation&lt;/b&gt;&lt;span style=&quot;color:#6b7280&quot;&gt; — and it only wires&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#c6ddcd;fontColor=#1d6b3f;align=left;spacingLeft=16;spacingRight=16;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="750" y="766" width="542" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="pb3" value="&lt;b&gt;no Flutter below the line&lt;/b&gt;&lt;span style=&quot;color:#6b7280&quot;&gt; — those packages run under dart test, dev_dependencies included&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#c6ddcd;fontColor=#1d6b3f;align=left;spacingLeft=16;spacingRight=16;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="750" y="814" width="542" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="pb4" value="&lt;b&gt;infra cannot name a domain type&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#6b7280&quot;&gt;so turning a technical failure into a domain one is the repository's job by construction, and not by agreement&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#c6ddcd;fontColor=#1d6b3f;align=left;spacingLeft=16;spacingRight=16;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="750" y="862" width="542" height="42" as="geometry"/>
                </mxCell>

